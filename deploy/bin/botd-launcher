#!/bin/sh
# botd 用の最小ランチャー（systemd の ExecStart から呼ばれる）。
#
# botd は匿名 stdin から 1 行 JSON {"secret":[32個のbyte値]} を読む
# （--bootstrap-stdin 必須。src/src/bin/botd.rs の read_bootstrap）。
# このスクリプトは secret を起動ごとに /dev/urandom から生成し、here-document
# （dash では小さい here-document は一時ファイルでなくパイプ。実装依存で、本リポジトリでは
# 未検証）経由で botd の stdin へ渡して exec する。secret は argv・環境変数・
# ログへ出さない。
#
# 重要な未解決制約: secret はこのスクリプトも保持しないため、起動後に botctl
# （--bootstrap-stdin）で接続する経路は現状ない。この構成の botd は「systemd が
# 監督して常駐させる」ことだけができ、botctl での照会・操作はできない。
# 操作可能な常駐ランチャー（secret の安全な保管と botctl への受渡し）は未提供。
#
# 使い方: botd-launcher /abs/path/botd --file ... --bootstrap-stdin ...
set -eu
umask 077
secret=$(od -An -v -tu1 -N32 /dev/urandom | tr -s ' \n' ',' | sed 's/^,//; s/,$//')
case $secret in
*[!0-9,]* | "")
    echo "botd-launcher: failed to generate secret" >&2
    exit 1
    ;;
esac
exec "$@" <<EOF
{"secret":[$secret]}
EOF
