# botd 常駐用 systemd unit（Ubuntu のみ対応）。
# 手順は docs/linux-deployment.md。この unit は実機の systemd では未検証。
#
# 配置の前提（docs/linux-deployment.md のとおりに作成する）:
#   /opt/discord-rs/bin/botd, botctl, src(Gateway)   root:root 0755
#   /etc/discord-rs/bots.toml     配置設定（秘密値なし）            root:discord-rs 0640
#   /etc/discord-rs/botd.secret   管理用 secret（16進 64 文字）     discord-rs:discord-rs 0600
#   /etc/discord-rs/botd.env      token 等（EnvironmentFile）        root:discord-rs 0640 または 0600
#   /var/lib/discord-rs           状態（StateDirectory が 0700 で作成）
#
# token はこのファイルに書かない。token_env に対応する環境変数は botd.env にだけ置く。
# （botd は環境変数から token を読み、そのBot用Gatewayにだけ渡す。Core には渡さない。）

[Unit]
Description=discord-rs botd (Gateway/Core shard supervisor)
After=network-online.target
Wants=network-online.target
# 起動失敗の連続で無限に再起動しない（Restart=on-failure と併用）
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# --- 起動方式 ---
# botd は sd_notify（READY/WATCHDOG/STOPPING）に対応済みだが、実 systemd では未検証のため無効のまま。
# 有効化する場合は、実機で READY=1 が届き Watchdog が働くことを確認してから、下の2行のコメントを外す
# （Type=simple を Type=notify に置き換える）。誤って WatchdogSec だけ有効にしないこと。
#   Type=notify
#   WatchdogSec=30s
Type=simple

User=discord-rs
Group=discord-rs

# 管理用 secret は --secret-file で渡す（64 文字の 16 進 1 行。discord-rs 所有・モード 0600 か 0400 のみ受理。
# 満たさなければ botd は起動を拒否する）。管理用 loopback ポートは --control-port で固定し、botctl は
# 同じ secret ファイルと --port で接続する（docs/linux-deployment.md「管理 secret」）。
# 作成: sudo /opt/discord-rs/bin/botctl secret generate --out /etc/discord-rs/botd.secret
#       sudo chown discord-rs:discord-rs /etc/discord-rs/botd.secret
# secret は argv・環境変数に載せない（ここに書くのはファイルのパスだけ）。
ExecStart=/opt/discord-rs/bin/botd \
    --file /etc/discord-rs/bots.toml \
    --runtime-root /var/lib/discord-rs/runtime \
    --gateway-program /opt/discord-rs/bin/src \
    --secret-file /etc/discord-rs/botd.secret \
    --control-port 47321 \
    --stop-children-on-exit

# 秘密は別ファイル。先頭 "-" は付けない（ファイルが無ければ起動失敗にする）。
EnvironmentFile=/etc/discord-rs/botd.env

# 状態は /var/lib/discord-rs（0700, discord-rs 所有）。runtime-root はその配下。
StateDirectory=discord-rs discord-rs/runtime
StateDirectoryMode=0700
# /run/discord-rs（現状 botd は使用しない。将来の socket 等のために確保）
RuntimeDirectory=discord-rs
RuntimeDirectoryMode=0700
UMask=0077

# --- 停止 ---
# ExecStart の --stop-children-on-exit により、botd は SIGINT と SIGTERM のどちらでも、起動した全 Shard の
# Gateway 子を graceful に止めて（最大 30 秒）から終了する。止まった子の起動予約も解放する。
# このフラグ無しの botd は SIGINT(ctrl_c) のみを処理し、子を残す（SIGTERM では停止処理に入らない）。
# そのためフラグを外す場合は KillSignal=SIGINT に戻すこと。
# SIGTERM は systemd の既定で、フラグ有効時は botd が処理するため、KillSignal は既定の SIGTERM にする。
# KillMode=mixed: シグナルは主プロセスにのみ送り、残りの子は停止完了時／TimeoutStopSec（60 秒。botd の
# 30 秒の期限より長い）切れ時に systemd が cgroup ごと SIGKILL する。
# 孤児の再採用（生きている子を新しい botd が引き継ぐ）は未実装。この unit は実機の systemd では未検証。
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=60

# --- 再起動 ---
Restart=on-failure
RestartSec=5s

# --- 資源 ---
LimitNOFILE=65536

# --- ログは journald（stdout/stderr をそのまま渡す）---
StandardOutput=journal
StandardError=journal
SyslogIdentifier=botd

# --- サンドボックス ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# StateDirectory は自動で書込可になるが、範囲を明示する（状態ディレクトリのみ）。
ReadWritePaths=/var/lib/discord-rs
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Gateway が Discord へ外向き接続するため AF_INET/AF_INET6 を許可。管理用は loopback TCP のみ。
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# 追加の硬化（systemd-analyze security の指摘に対応。2026-11-14 の実 systemd smoke で動作確認）。
RemoveIPC=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
SystemCallArchitectures=native
# システムコールは @system-service のみ許可（通常のサーバ処理に必要な範囲）。@privileged と
# @resources は除外する。Rust/Tokio、ファイル、ネットワーク、子プロセス起動は含まれる。
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
